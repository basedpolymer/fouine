# tools-list.jsonl — le catalogue, en époque legacy.
#
# CINQ OUTILS, dans l'ordre du parcours qu'un agent doit faire : savoir ce
# qu'il y a, chercher, lire, rebondir de proche en proche, lister quand il ne
# trouve rien. L'ORDRE est figé ici parce qu'il est ce que le modèle lit en
# premier, et qu'un catalogue qui commence par `fouine_list_documents` invite à
# tout énumérer avant de chercher.
#
# `inputSchema` est écrit EN ENTIER : c'est le contrat que lit le modèle, et
# c'est le champ dont une dérive silencieuse coûterait le plus cher. La
# description et l'`outputSchema` portent `"<any>"` — leur prose doit pouvoir
# être améliorée sans faire rougir une transcription.
#
# `annotations` est écrit en entier lui aussi, et pour la même raison : c'est
# ce qu'un client lit AVANT d'appeler. `readOnlyHint: true` sur les cinq est ce
# qui lui permet de ne pas demander confirmation à chaque appel (CM-10) ; le
# jour où l'un des cinq cesserait d'être en lecture seule, cette ligne devrait
# rougir avant que le client ne l'apprenne à l'usage.

> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{}}}
< {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{}},"serverInfo":{"name":"fouine","title":"Fouine","version":"1.0.0-test"},"instructions":"<any>"}}

# En legacy, `tools/list` ne porte NI resultType NI ttlMs NI cacheScope : ces
# champs n'existent pas avant 2026-07-28, et les ajouter ferait échouer la
# validation de certains clients.
> {"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}
< {"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"fouine_status","title":"Fouine index status","annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Fouine index status"},"description":"<any>","outputSchema":"<any>","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"properties":{"include_roots":{"type":"boolean","default":true,"description":"<any>"},"include_agent":{"type":"boolean","default":true,"description":"<any>"}}}},{"name":"fouine_search","title":"Search the Fouine index","annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search the Fouine index"},"description":"<any>","outputSchema":"<any>","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["query"],"properties":{"query":{"type":"string","minLength":1,"maxLength":500,"description":"<any>"},"limit":{"type":"integer","minimum":1,"maximum":50,"default":10,"description":"<any>"},"cursor":{"type":"string","description":"<any>"},"mode":{"enum":["auto","lexical","hybrid"],"default":"auto","description":"<any>","type":"string"},"folder":{"type":"string","description":"<any>"},"ext":{"type":"string","description":"<any>"},"lang":{"type":"string","description":"<any>"},"source":{"enum":["native","ocr","transcript"],"description":"<any>","type":"string"},"doc_ids":{"type":"array","items":{"type":"integer"},"maxItems":50,"description":"<any>"},"snippet_chars":{"type":"integer","minimum":80,"maximum":800,"default":240,"description":"<any>"},"compact":{"default":false,"description":"Move the paths out of the hits: each hit keeps doc_id, page and snippet, and every document appears once in documents. Halves the size of a reply whose hits share a few documents.","type":"boolean"},"facet":{"description":"Also count the results by this dimension, returned in facets. doc_year is the year the document CARRIES (its own date, present on most documents); modified_year is the year its FILE was last changed — they answer different questions. Computed on the first page of results only.","enum":["doc_year","modified_year","folder","ext","source","lang"],"type":"string"},"fuzzy":{"default":"auto","description":"Tolerate spelling differences: auto widens only when the exact search finds fewer than 20 pages, on always, off never. Widened hits carry fuzzy_distance > 0 and the response says fuzzy_expanded.","enum":["off","auto","on"],"type":"string"},"marks":{"default":"guillemets","description":"What surrounds the matched words in a snippet: «…» (default), [ … ], ** … ** or nothing. Pick another one when the text itself uses «…» and you cannot tell the highlight from a quotation.","enum":["guillemets","brackets","asterisks","none"],"type":"string"},"since":{"description":"Only documents modified on or after this date, written YYYY-MM-DD (the file's own date, not the date printed inside it).","type":"string"}}}},{"name":"fouine_read_page","title":"Read one indexed page","annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Read one indexed page"},"description":"<any>","outputSchema":"<any>","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["doc_id","page"],"properties":{"doc_id":{"type":"integer","minimum":1},"page":{"type":"integer","minimum":1,"maximum":99999,"description":"<any>"},"max_chars":{"type":"integer","minimum":200,"maximum":40000,"default":8000,"description":"<any>"},"offset":{"type":"integer","minimum":0,"default":0,"description":"<any>"},"context_pages":{"type":"integer","minimum":0,"maximum":2,"default":0,"description":"<any>"}}}},{"name":"fouine_similar_pages","title":"Pages close to a given page","annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Pages close to a given page"},"description":"<any>","outputSchema":"<any>","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["doc_id","page"],"properties":{"doc_id":{"type":"integer","minimum":1},"page":{"type":"integer","minimum":1,"maximum":99999},"limit":{"type":"integer","minimum":1,"maximum":50,"default":10},"min_cosine":{"type":"number","minimum":0,"maximum":1,"default":0,"description":"<any>"},"exclude_same_document":{"type":"boolean","default":true},"folder":{"type":"string","description":"<any>"},"ext":{"type":"string","description":"<any>"},"preview_chars":{"type":"integer","minimum":80,"maximum":600,"default":200},"encode_if_missing":{"type":"boolean","default":false,"description":"<any>"},"compact":{"type":"boolean","default":false,"description":"<any>"}}}},{"name":"fouine_list_documents","title":"List indexed documents","annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List indexed documents"},"description":"<any>","outputSchema":"<any>","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"properties":{"folder":{"type":"string","description":"<any>"},"ext":{"type":"string","description":"<any>"},"path_contains":{"type":"string","maxLength":200,"description":"<any>"},"state":{"type":"string","enum":["indexed","failed","skipped","pending","any"],"default":"indexed","description":"<any>"},"limit":{"type":"integer","minimum":1,"maximum":200,"default":50},"cursor":{"type":"string","description":"<any>"},"order":{"type":"string","enum":["path","pages","recent"],"default":"path","description":"<any>"}}}}]}}

# Le DÉFAUT de `min_cosine` est 0, et ce n'est pas un oubli : D2 § 5.5 propose
# 0,80, et la mesure du 03/09/2026 a infirmé le raisonnement qui la fondait —
# la bande 0,78-0,88 d'e5-small ne sépare pas le pertinent du reste. Il est
# figé dans cette transcription parce qu'un retour silencieux à 0,80 rendrait
# l'outil muet sur les voisinages qu'il sert le mieux.

# `tools/list` sans `params` du tout : beaucoup de clients l'écrivent ainsi.
> {"jsonrpc":"2.0","id":3,"method":"tools/list"}
< {"jsonrpc":"2.0","id":3,"result":{"tools":"<any>"}}
