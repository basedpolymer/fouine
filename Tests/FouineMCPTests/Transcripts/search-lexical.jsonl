# search-lexical.jsonl — `fouine_search` sans modèle sémantique, contre la base
# jetable de deux documents et six pages.
#
# `elapsed_ms` porte `"<any>"` : c'est une durée. TOUT LE RESTE est figé, et en
# particulier les champs sémantiques à `null` — un modèle qui lit
# `semantic_stats: null` sait que le canal vectoriel n'a pas répondu, là où un
# champ ABSENT ne lui apprend rien.

> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{}}}
< {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{}},"serverInfo":{"name":"fouine","title":"Fouine","version":"1.0.0-test"},"instructions":"<any>"}}

# 1. La première page de résultats. `bm25` vaut 0 ici et ce n'est pas un bogue :
#    le terme est sur les six pages de l'index jetable, donc son IDF est nul.
#    `abs_path` est NUL parce que le volume "TEST-VOL" n'est pas monté — c'est
#    exactement l'état d'un disque externe débranché, et les hits sortent quand
#    même.
> {"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"fouine_search","arguments":{"query":"electrolyse","limit":2}}}
< {"jsonrpc":"2.0","id":2,"result":{"content":[{"type":"text","text":"<any>"}],"structuredContent":{"hits":[{"doc_id":1,"page":1,"path":"Users/essai/Livres/document-1.pdf","abs_path":null,"link":"fouine://open?doc=1&page=1","folder":"Livres","ext":"pdf","snippet":"«electrolyse» enthalpie page 1 du document 1","bm25":0,"source":"native","engine":"none","fuzzy_distance":0,"semantic_only":false,"why":{"kind":"exact","terms_found":["electrolyse"]},"embedded_image":null,"relevance_pct":100,"slide":null,"time_seconds":null},{"doc_id":1,"page":2,"path":"Users/essai/Livres/document-1.pdf","abs_path":null,"link":"fouine://open?doc=1&page=2","folder":"Livres","ext":"pdf","snippet":"«electrolyse» enthalpie page 2 du document 1","bm25":0,"source":"native","engine":"none","fuzzy_distance":0,"semantic_only":false,"why":{"kind":"exact","terms_found":["electrolyse"]},"embedded_image":null,"relevance_pct":100,"slide":null,"time_seconds":null}],"total_pages":6,"total_docs":2,"totals_approximate":false,"mode_used":"lexical","semantic_available":false,"semantic_coverage_pct":0,"semantic_stats":null,"semantic_rank_scale":null,"note":"semantic model not installed — lexical only (`fouine model download` installs it)","name_matches":[],"fuzzy_fallback":false,"quorum":false,"hybrid_disarmed":null,"has_more":true,"next_cursor":"eyJmIjoiYjBhYmIyNWIxOTU5NGZiYWI2YzI5ZWVkIiwibyI6MiwidiI6MX0","elapsed_ms":"<any>","documents":{},"facets":null,"fuzzy_expanded":false,"semantic_scope":{"filtered":false,"pages":6,"vectorised":0}}}}

# 2. La page suivante, par le curseur rendu ci-dessus. Le décalage est DANS le
#    jeton ; les autres arguments doivent être identiques, et l'empreinte le
#    vérifie.
> {"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"fouine_search","arguments":{"query":"electrolyse","limit":2,"cursor":"eyJmIjoiYjBhYmIyNWIxOTU5NGZiYWI2YzI5ZWVkIiwibyI6MiwidiI6MX0"}}}
