      }
    },
    "%@\n\nForced by the environment variable %@: this value cannot be changed here while the variable is set.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nForced by the environment variable %@: this value cannot be changed here while the variable is set."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nForcé par la variable d’environnement %2$@ : cette valeur ne peut pas être modifiée ici tant que la variable est posée."
          }
        }
      }
    },
    "%@\n\nThe document has been moved, renamed or deleted since the last indexing pass. Run “Index now” to bring the index up to date; the other results stay usable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThe document has been moved, renamed or deleted since the last indexing pass. Run “Index now” to bring the index up to date; the other results stay usable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nLe document a été déplacé, renommé ou supprimé depuis la dernière indexation. Relancez « Indexer maintenant » pour remettre l’index à jour ; les autres résultats restent utilisables."
          }
        }
      }
    },
