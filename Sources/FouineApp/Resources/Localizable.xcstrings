    "When Fouine may work on its own is set in Settings ▸ Indexing ▸ When to update automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Fouine may work on its own is set in Settings ▸ Indexing ▸ When to update automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les moments où Fouine peut travailler seule se règlent dans Réglages ▸ Indexation ▸ Quand mettre à jour automatiquement."
          }
        }
      }
    },
    "When the Mac is plugged in and idle, a few minutes at a time, once every scanned page has been read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the Mac is plugged in and idle, a few minutes at a time, once every scanned page has been read."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l’ordinateur est branché et au repos, par courtes tranches, une fois toutes les pages scannées lues."
          }
        }
      }
    },
    "When to update automatically": {
      "extractionState": "manual",
