        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanned pages carry most wrong letters. When a search finds nothing, Fouine also tries close spellings in every document."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lettres fausses viennent surtout des pages scannées. Quand une recherche ne trouve rien, Fouine essaie aussi les orthographes proches dans tous les documents."
          }
        }
      }
