          }
        }
      }
    },
    "Word search and meaning search combined: the %@ best pages, and no more. Refine the query or the filters to see other pages, or turn “Also search by meaning” off to browse the whole list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word search and meaning search combined: the %@ best pages, and no more. Refine the query or the filters to see other pages, or turn “Also search by meaning” off to browse the whole list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche par mots et par le sens combinées : les %@ meilleures pages, pas davantage. Affinez la requête ou les filtres pour voir d’autres pages, ou éteignez « Chercher aussi par le sens » pour parcourir toute la liste."
          }
        }
      }
    },
    "Words found on this page": {
